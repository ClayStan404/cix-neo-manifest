<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal source manifest for the CIX Neo native Debian build system. -->
<manifest>
  <remote name="cix"
          fetch="ssh://git@gitmirror.cixcomputing.com/"
          review="ssh://git@gitmirror.cixcomputing.com/" />

  <!-- Temporary home for new projects until internal repositories exist. -->
  <remote name="github"
          fetch="ssh://git@github.com/ClayStan404/" />

  <default remote="cix"
           sync-c="true"
           sync-j="8"
           sync-tags="false" />

  <project name="cix_opensource/linux"
           path="sources/linux"
           revision="cix_6.6_master_dev"
           groups="kernel" />

  <project name="cix_opensource/gpu_kernel"
           path="sources/gpu-kernel"
           revision="cix_r54p1-11eac0_dev"
           groups="gpu-dkms" />

  <project name="cix-neo-build-scripts"
           path="build-scripts"
           remote="github"
           revision="main"
           groups="build-system" />

  <project name="cix-neo-debian"
           path="debian"
           remote="github"
           revision="main"
           groups="debian-packaging" />
</manifest>
