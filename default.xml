<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal source manifest for the CIX Neo native Debian build system. -->
<manifest>
  <remote name="cix"
          fetch="ssh://git@gitmirror.cixcomputing.com/"
          review="ssh://git@gitmirror.cixcomputing.com/" />

  <!-- Temporary home for new projects until internal repositories exist. -->
  <remote name="github"
          fetch="ssh://git@github.com/ClayStan404/" />

  <remote name="cix-oss-github"
          fetch="ssh://git@github.com/cix-oss/" />

  <remote name="cixtech-github"
          fetch="ssh://git@github.com/cixtech/" />

  <default remote="cix"
           sync-c="true"
           sync-j="8"
           sync-tags="false" />

  <project name="cix_opensource/linux"
           path="sources/linux"
           revision="cix_6.6_master_dev"
           groups="kernel" />

  <project name="cix-linux-kernel"
           path="sources/linux-stable"
           remote="cix-oss-github"
           revision="master"
           groups="kernel-stable" />

  <project name="cix-linux-main"
           path="sources/linux-main"
           remote="cixtech-github"
           revision="main"
           groups="kernel-stable" />

  <project name="cix_opensource/gpu_kernel"
           path="sources/gpu-kernel"
           revision="cix_r54p1-11eac0_dev"
           groups="gpu-dkms" />

  <project name="cix_opensource/vpu_driver"
           path="sources/vpu-driver"
           revision="cix_vpu_dev"
           groups="vpu-dkms" />

  <project name="cix_opensource/npu_driver"
           path="sources/npu-driver"
           revision="cix_x2_r2p1_dev"
           groups="npu-dkms" />

  <project name="cix-neo-build-scripts"
           path="build-scripts"
           remote="github"
           revision="master"
           groups="build-system" />

  <project name="cix-neo-debian"
           path="debian"
           remote="github"
           revision="master"
           groups="debian-packaging" />
</manifest>
